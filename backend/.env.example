# MIMO TTS API Configuration
MIMO_API_KEY=your-api-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com

# Server
SERVER_PORT=30231

# Database
DB_PATH=data/mimo.db

# Concurrency
MAX_CONCURRENT=10
MAX_ACTIVE_TASKS=20

# Rate limiting
# MIMO_RPM: API request rate limit (requests per minute). Default: 90.
MIMO_RPM=90
# MIMO_TOKEN_BUDGET_RPM: Max token consumption rate (tokens per minute). Default: 1000000.
MIMO_TOKEN_BUDGET_RPM=1000000

# Cache
CACHE_DIR=data/cache
